@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}
<h1>Something went wrong</h1>
<p class="lede">The register could not finish that request. The agreement record was not silently changed.</p>
@if (Model.ShowRequestId)
{
    <p>Reference <code>@Model.RequestId</code></p>
}
<a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">Back to the dashboard</a>
