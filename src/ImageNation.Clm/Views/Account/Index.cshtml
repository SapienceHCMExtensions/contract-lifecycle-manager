@model List<AppUser>
@{
    ViewData["Title"] = "Sign in";
}
<p class="kicker">Image Nation Abu Dhabi</p>
<h1>Who is working today?</h1>
<p class="lede">This sign-in stands in for Microsoft 365. Pick a persona. There is no password in this local build, and nothing here is a real identity provider.</p>
<div class="persona-grid">
@foreach (var person in Model)
{
    <form asp-action="SignIn" method="post">
        <input type="hidden" name="id" value="@person.Id" />
        <button class="persona-card" type="submit">
            <strong>@person.Name</strong>
            <small>@Labels.Text(person.Role)</small>
            <small>@person.Title · @person.Department</small>
        </button>
    </form>
}
</div>
